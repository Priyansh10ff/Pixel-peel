# ─────────────────────────────────────────────────────────────
#  PixelPeel — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
wheels/
.eggs/
MANIFEST

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── AI model cache (downloaded at runtime, not tracked) ──────
.u2net/
*.onnx

# ── Output images (user data, not source code) ───────────────
output/
!output/.gitkeep

# ── Testing & coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.lcov

# ── Type checking ─────────────────────────────────────────────
.mypy_cache/
.pyright/
pyrightconfig.json

# ── Linting ───────────────────────────────────────────────────
.ruff_cache/

# ── IDEs ──────────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# PyCharm / JetBrains
.idea/
*.iml
*.iws

# Spyder
.spyderproject.cfg
.spyproject/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
__MACOSX/

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ─────────────────────────────────────────────────────
*~
.fuse_hidden*
.Trash-*
.nfs*

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Secrets ───────────────────────────────────────────────────
.env
.env.*
secrets.*
*.pem
*.key
